[Unit]
Description=Xearch production download worker
Requires=xearch-capture.service
After=network-online.target xearch-capture.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/exedev/xearch-data
Environment=PATH=/home/exedev/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/exedev/.local/bin/bun /home/exedev/xearch-worker/scripts/production-worker.ts
Restart=always
RestartSec=5s
UMask=0077
StandardOutput=append:/home/exedev/xearch-data/.local-captures/logs/production-worker.log
StandardError=append:/home/exedev/xearch-data/.local-captures/logs/production-worker.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/exedev/xearch-data

[Install]
WantedBy=default.target

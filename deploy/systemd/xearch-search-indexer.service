[Unit]
Description=Xearch background search indexer (Rust drop-dir watcher)
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
Environment=SEARCH_BASE_DIR=%h/xearch-search
Environment=SEARCH_BIN=%h/Coding/xearch/search/target/release/xearch-search
ReadWritePaths=%h
ExecStart=${SEARCH_BIN} --base-dir ${SEARCH_BASE_DIR} watch
StandardOutput=append:${SEARCH_BASE_DIR}/logs/indexer.log
StandardError=append:${SEARCH_BASE_DIR}/logs/indexer.log

[Install]
WantedBy=default.target
